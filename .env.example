# Copy this file to .env and fill in values locally. Never commit .env.
GOLD_TWELVE_DATA_API_KEY=
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_CHAT_ID=

# Optional runtime settings
GOLD_TIMEFRAME=15min
GOLD_POLL_SECONDS=45
GOLD_RISK_ATR_MULTIPLIER=1.5
GOLD_TP1_R=1.0
GOLD_TP2_R=2.0

# Optional override; leave empty for the timeframe-scaled one-day default
SIGNAL_TTL_CANDLES=
GOLD_RETRY_ATTEMPTS=3
GOLD_RETRY_BASE_SECONDS=1
